# Usage: . ./cross.env
export PROJ="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export STAGE4_PREFIX="$PROJ/toolchain/install"
export STAGE4_SYSROOT="$PROJ/dev"
export STAGE4_DIST="$PROJ/dist"
export PATH="$STAGE4_PREFIX/bin:$PATH"

export CC="clang"
export CXX="clang++"
export AR="llvm-ar"
export NM="llvm-nm"
export RANLIB="llvm-ranlib"
export STRIP="llvm-strip"
export LD="ld.lld"

export CFLAGS="-O2 -pipe --sysroot=$STAGE4_SYSROOT"
export CXXFLAGS="-O2 -pipe --sysroot=$STAGE4_SYSROOT"
export LDFLAGS="-fuse-ld=lld --sysroot=$STAGE4_SYSROOT"

export PKG_CONFIG_DIR=""
export PKG_CONFIG_LIBDIR="$STAGE4_SYSROOT/usr/lib64/pkgconfig:$STAGE4_SYSROOT/usr/lib/pkgconfig:$STAGE4_SYSROOT/usr/share/pkgconfig"
export PKG_CONFIG_SYSROOT_DIR="$STAGE4_SYSROOT"
